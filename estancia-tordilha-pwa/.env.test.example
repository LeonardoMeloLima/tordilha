# Credenciais para os testes E2E (Playwright). Copie para .env.test e preencha.
# .env.test NÃO é commitado (ver .gitignore). NUNCA versione credenciais reais.
#
# Use um usuário de teste DEDICADO (de preferência terapeuta com >= 1 recorrência
# ativa). Os testes fazem apenas leitura/navegação — não criam/aprovam/deletam dados.

E2E_TEST_EMAIL=usuario-de-teste@exemplo.com
E2E_TEST_PASSWORD=senha-do-usuario-de-teste

# Onde o app está rodando. Local (default) sobe o Vite automaticamente.
# Para testar contra produção: https://estancia-tordilha.vercel.app
E2E_BASE_URL=http://localhost:5173
